---
// Vertical timeline: a copper line draws down as you scroll and each step lights up
// as the line reaches it. All steps are plain list items in the HTML.
interface Step { num: string; when?: string; name?: string; what: string; deliverables?: string[] }
interface Props { steps: Step[]; compact?: boolean }
// compact: step name and chips only, for pages that should scan fast
const { steps, compact = false } = Astro.props;
---
<div class="tl">
  <span class="tl-rail" aria-hidden="true"><span class="tl-fill" data-line></span></span>
  <ol class="tl-list">
    {steps.map((s) => (
      <li class="tl-item" data-activate>
        <span class="tl-dot" aria-hidden="true"></span>
        <span class="tl-n">{s.num}</span>
        <div class="tl-body" data-reveal>
          {s.when && <p class="tl-when">{s.when}</p>}
          {s.name && <h3 class="tl-t">{s.name}</h3>}
          {!(compact && s.name) && <p class:list={['tl-d', { solo: !s.name }]}>{s.what}</p>}
          {s.deliverables && s.deliverables.length > 0 && <ul class="tl-dl">{s.deliverables.map((d) => <li>{d}</li>)}</ul>}
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .tl { position: relative; }
  .tl-rail { position: absolute; left: 11px; top: 8px; bottom: 8px; width: 1px; background: var(--sx-border-hover); }
  .tl-fill { position: absolute; inset: 0; background: var(--sx-accent); transform-origin: 50% 0; }
  :global(.motion) .tl-fill { transform: scaleY(0); }
  .tl-list { list-style: none; display: grid; gap: 8px; }
  .tl-item { position: relative; display: grid; grid-template-columns: 24px 1fr; column-gap: 26px; padding: 22px 0 30px; }
  @media (min-width: 768px) { .tl-item { grid-template-columns: 24px 110px 1fr; } }
  .tl-dot { grid-row: 1 / span 2; width: 23px; height: 23px; margin-top: 4px; border: 1px solid var(--sx-border-hover); background: var(--sx-bg); transform: rotate(45deg) scale(.55); transition: transform .6s cubic-bezier(.16, 1, .3, 1), background-color .4s, border-color .4s; position: relative; z-index: 1; }
  :global(.section-dark) .tl-dot { background: var(--sx-dark); }
  .tl-n { font-family: var(--sx-font-condensed); font-size: 64px; line-height: .85; color: transparent; -webkit-text-stroke: 1px var(--sx-text-muted); transition: color .5s, -webkit-text-stroke-color .5s; }
  @media (max-width: 767px) { .tl-n { font-size: 44px; } }
  .tl-when { font-family: var(--sx-font-condensed); letter-spacing: .14em; font-size: 14px; color: var(--sx-accent); text-transform: uppercase; }
  .tl-t { font-family: var(--sx-font-condensed); font-size: clamp(26px, 2.6vw, 36px); line-height: 1; text-transform: uppercase; letter-spacing: .02em; margin-top: 6px; }
  .tl-d { color: var(--sx-text-secondary); margin-top: 10px; max-width: 620px; }
  .tl-d.solo { margin-top: 4px; color: var(--sx-text); font-size: 18px; line-height: 1.55; }
  .tl-dl { list-style: none; margin-top: 14px; display: flex; flex-wrap: wrap; gap: 6px; }
  .tl-dl li { font-size: 12px; color: var(--sx-text-secondary); border: 1px solid var(--sx-border); padding: 5px 9px; }
  @media (max-width: 767px) { .tl-body { grid-column: 2; } }
  /* lit state: without motion every step is lit */
  :global(html:not(.motion)) .tl-dot, .tl-item:global(.on) .tl-dot { transform: rotate(45deg) scale(1); background: var(--sx-accent); border-color: var(--sx-accent); }
  :global(html:not(.motion)) .tl-n, .tl-item:global(.on) .tl-n { color: var(--sx-accent); -webkit-text-stroke-color: var(--sx-accent); }
</style>
