---
// Hero 3D graphic. A particle globe (the answer space), a wireframe core (your brand) and
// seven engines on tilted orbits; answers travel from the engines into the core and the
// "named" counter ticks up. Drawn on a 2D canvas with a small perspective projection, so
// there is no WebGL and no library to load. Decorative and illustrative: aria-hidden.
import { ENGINES } from '../data/geo';
---
<div class="g3d" data-g3d data-engines={JSON.stringify(ENGINES)} aria-hidden="true">
  <canvas></canvas>
  <p class="g3d-hud g3d-tl"><i></i>Answer space · illustrative</p>
  <p class="g3d-hud g3d-br">Named <b data-g3d-n>0</b>/{ENGINES.length}</p>
</div>

<style>
  .g3d { position: relative; width: 100%; aspect-ratio: 1; max-height: 78svh; }
  .g3d canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .g3d-hud { position: absolute; font-family: var(--sx-font-condensed); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--sx-text-muted); display: inline-flex; align-items: center; gap: 8px; }
  .g3d-tl { left: 14%; top: 13%; }
  .g3d-tl i { width: 7px; height: 7px; background: var(--sx-accent); animation: g3d-blink 1.4s steps(1) infinite; }
  .g3d-br { right: 16%; bottom: 12%; border: 1px solid var(--sx-border-hover); padding: 6px 10px; color: var(--sx-text); background: color-mix(in srgb, var(--sx-dark) 70%, transparent); }
  .g3d-br b { color: var(--sx-accent); font-weight: 400; font-size: 18px; line-height: 1; }
  @keyframes g3d-blink { 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .g3d-tl i { animation: none; } }
</style>

<script>
  const BOT = /bot|crawl|spider|slurp|chatgpt|perplexity|claude|gptbot/i.test(navigator.userAgent);
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches || BOT;
  const TAU = Math.PI * 2;

  // CSS colour token -> "r,g,b". The build minifies hex (#FFFFFF becomes #fff), so read every form.
  const rgb = (v: string, fb: string) => {
    v = v.trim();
    let m = v.match(/^#([0-9a-f]{3})$/i);
    if (m) return m[1].split('').map((c) => parseInt(c + c, 16)).join(',');
    m = v.match(/^#([0-9a-f]{6})/i);
    if (m) { const n = parseInt(m[1], 16); return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`; }
    m = v.match(/^rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/i);
    return m ? `${m[1]},${m[2]},${m[3]}` : fb;
  };

  document.querySelectorAll<HTMLElement>('[data-g3d]').forEach((root) => {
    const cv = root.querySelector('canvas')!;
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const names: string[] = JSON.parse(root.dataset.engines || '[]');
    const counter = root.querySelector<HTMLElement>('[data-g3d-n]');

    // ---- theme
    let ink = '245,240,235', acc = '200,129,74', bg = '20,18,16';
    const theme = () => {
      const cs = getComputedStyle(document.documentElement);
      ink = rgb(cs.getPropertyValue('--sx-text'), ink);
      acc = rgb(cs.getPropertyValue('--sx-accent'), acc);
      bg = rgb(cs.getPropertyValue('--sx-dark'), bg);
    };
    theme();
    new MutationObserver(theme).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // ---- geometry
    const small = window.innerWidth < 720;
    const N = small ? 620 : 1150;
    const pts = new Float32Array(N * 3);
    const hot = new Uint8Array(N);
    const GA = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < N; i++) {
      const y = 1 - (2 * (i + 0.5)) / N, r = Math.sqrt(1 - y * y), th = i * GA;
      pts[i * 3] = Math.cos(th) * r; pts[i * 3 + 1] = y; pts[i * 3 + 2] = Math.sin(th) * r;
      hot[i] = (i * 7919) % 9 === 0 ? 1 : 0;
    }
    // core: icosahedron wireframe
    const PHI = (1 + Math.sqrt(5)) / 2;
    const iv: number[][] = [];
    for (const a of [-1, 1]) for (const b of [-PHI, PHI]) { iv.push([0, a, b], [a, b, 0], [b, 0, a]); }
    const il = Math.hypot(1, PHI);
    const core = iv.map((v) => v.map((c) => (c / il) * 0.36));
    const edges: [number, number][] = [];
    for (let i = 0; i < 12; i++) for (let j = i + 1; j < 12; j++) {
      const d = Math.hypot(iv[i][0] - iv[j][0], iv[i][1] - iv[j][1], iv[i][2] - iv[j][2]);
      if (Math.abs(d - 2) < 0.01) edges.push([i, j]);
    }
    // orbits and the engines riding them
    const rings = [
      { r: 1.3, ax: 0.38, az: 0.16, sp: 0.2 },
      { r: 1.48, ax: -0.52, az: -0.42, sp: -0.15 },
      { r: 1.66, ax: 1.02, az: 0.48, sp: 0.11 },
    ];
    const slots = [0, 0, 0, 1, 1, 2, 2];
    const perRing = [3, 2, 2];
    const seen = [0, 0, 0];
    const eng = names.map((name, i) => {
      const ring = slots[i % slots.length];
      const ph = (seen[ring]++ / perRing[ring]) * TAU + ring * 0.9;
      return { name: name.toUpperCase(), ring, ph, x: 0, y: 0, z: 0, sx: 0, sy: 0, p: 1, hit: 0 };
    });

    // ---- state
    let W = 0, H = 0, dpr = 1, R = 0, cx = 0, cy = 0;
    let t = 0, spin = 0, flash = 0, intro = reduced ? 1 : 0;
    let mx = 0, my = 0, tmx = 0, tmy = 0;
    const hits = new Set<number>();
    const pulses: { e: number; t: number }[] = [];
    let nextFire = 1.2, hold = 0;
    const D = 5; // camera distance in globe radii

    const size = () => {
      const r = root.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = Math.max(1, Math.round(r.width * dpr)); H = Math.max(1, Math.round(r.height * dpr));
      cv.width = W; cv.height = H; cx = W / 2; cy = H / 2; R = Math.min(W, H) * 0.27;
    };
    new ResizeObserver(() => { size(); if (reduced) draw(0); }).observe(root);
    size();

    // rotation helpers write into a shared tuple
    const o = [0, 0, 0];
    const xf = (x: number, y: number, z: number, sy: number, cyy: number, sxx: number, cxx: number) => {
      const x1 = x * cyy + z * sy, z1 = -x * sy + z * cyy;        // around Y
      o[0] = x1; o[1] = y * cxx - z1 * sxx; o[2] = y * sxx + z1 * cxx; // around X
    };

    function draw(dt: number) {
      t += dt; flash = Math.max(0, flash - dt * 2.4);
      if (!reduced) intro = Math.min(1, intro + dt / 1.3);
      const ease = 1 - Math.pow(1 - intro, 3);
      mx += (tmx - mx) * 0.06; my += (tmy - my) * 0.06;
      const vel = (window as any).__lenis?.velocity ?? 0;
      spin += dt * (0.16 + Math.min(Math.abs(vel), 40) * 0.02);
      const gy = spin + mx * 0.5, gx = -0.34 + my * 0.28;
      const sgy = Math.sin(gy), cgy = Math.cos(gy), sgx = Math.sin(gx), cgx = Math.cos(gx);
      const Rr = R * (0.7 + 0.3 * ease);
      ctx!.clearRect(0, 0, W, H);

      // core glow
      const g = ctx!.createRadialGradient(cx, cy, 0, cx, cy, Rr * 0.95);
      g.addColorStop(0, `rgba(${acc},${0.2 + flash * 0.22})`); g.addColorStop(1, `rgba(${acc},0)`);
      ctx!.fillStyle = g; ctx!.fillRect(cx - Rr, cy - Rr, Rr * 2, Rr * 2);

      // globe particles, with a scan band sweeping pole to pole
      const band = Math.sin(t * 0.55) * 1.15;
      let cur = -1;
      for (let i = 0; i < N; i++) {
        const y0 = pts[i * 3 + 1];
        xf(pts[i * 3], y0, pts[i * 3 + 2], sgy, cgy, sgx, cgx);
        const p = D / (D - o[2]);
        const d01 = (o[2] + 1) / 2;
        const bd = Math.abs(y0 - band);
        const lit = bd < 0.07 ? 1 - bd / 0.07 : 0;
        const isHot = hot[i] === 1 || lit > 0.35 ? 1 : 0;
        if (isHot !== cur) { ctx!.fillStyle = `rgb(${isHot ? acc : ink})`; cur = isHot; }
        ctx!.globalAlpha = Math.min(1, (0.1 + 0.75 * d01 * d01 + lit * 0.55) * ease);
        const s = Math.max(1, (hot[i] ? 2.8 : 1.8) * p * dpr * (1 + lit * 0.5));
        ctx!.fillRect(cx + o[0] * Rr * p - s / 2, cy - o[1] * Rr * p - s / 2, s, s);
      }
      ctx!.globalAlpha = 1;

      // orbits
      ctx!.lineWidth = dpr;
      rings.forEach((rg) => {
        const sa = Math.sin(rg.ax), ca = Math.cos(rg.ax), sz = Math.sin(rg.az), cz = Math.cos(rg.az);
        const SEG = 120; const upto = Math.floor(SEG * ease);
        let px = 0, py = 0, pz = 0;
        for (let k = 0; k <= upto; k++) {
          const th = (k / SEG) * TAU;
          const x = rg.r * Math.cos(th), z = rg.r * Math.sin(th);
          const y1 = -z * sa, z1 = z * ca;              // tilt around X
          xf(x * cz - y1 * sz, x * sz + y1 * cz, z1, sgy, cgy, sgx, cgx); // then Z, then global
          const p = D / (D - o[2]);
          const X = cx + o[0] * Rr * p, Y = cy - o[1] * Rr * p;
          if (k > 0 && k % 2 === 0) {
            ctx!.strokeStyle = `rgba(${ink},${0.1 + 0.34 * ((o[2] + pz) / 2 / rg.r + 1) / 2})`;
            ctx!.beginPath(); ctx!.moveTo(px, py); ctx!.lineTo(X, Y); ctx!.stroke();
          }
          px = X; py = Y; pz = o[2];
        }
      });

      // engines
      eng.forEach((e) => {
        const rg = rings[e.ring];
        const th = e.ph + t * rg.sp;
        const sa = Math.sin(rg.ax), ca = Math.cos(rg.ax), sz = Math.sin(rg.az), cz = Math.cos(rg.az);
        const x = rg.r * Math.cos(th), z = rg.r * Math.sin(th);
        const y1 = -z * sa, z1 = z * ca;
        xf(x * cz - y1 * sz, x * sz + y1 * cz, z1, sgy, cgy, sgx, cgx);
        e.x = o[0]; e.y = o[1]; e.z = o[2]; e.p = D / (D - o[2]);
        e.sx = cx + o[0] * Rr * e.p; e.sy = cy - o[1] * Rr * e.p;
        e.hit = Math.max(0, e.hit - dt * 1.6);
      });

      // core wireframe (counter-rotating)
      const ky = -spin * 1.7, kx = t * 0.35;
      const sk = Math.sin(ky), ck = Math.cos(ky), sx2 = Math.sin(kx), cx2 = Math.cos(kx);
      const cs = core.map((v) => { xf(v[0], v[1], v[2], sk, ck, sx2, cx2); xf(o[0], o[1], o[2], sgy, cgy, sgx, cgx); const p = D / (D - o[2]); return [cx + o[0] * Rr * p * (1 + flash * 0.12), cy - o[1] * Rr * p * (1 + flash * 0.12), o[2]]; });
      ctx!.lineWidth = dpr * (1.1 + flash * 0.9);
      edges.forEach(([a, b]) => {
        const zz = (cs[a][2] + cs[b][2]) / 2;
        ctx!.strokeStyle = `rgba(${acc},${(0.45 + 0.5 * (zz / 0.36 + 1) / 2 + flash * 0.3) * ease})`;
        ctx!.beginPath(); ctx!.moveTo(cs[a][0], cs[a][1]); ctx!.lineTo(cs[b][0], cs[b][1]); ctx!.stroke();
      });

      // answers travelling into the core
      for (let i = pulses.length - 1; i >= 0; i--) {
        const pu = pulses[i]; pu.t += dt / 0.85;
        const e = eng[pu.e];
        if (pu.t >= 1) {
          pulses.splice(i, 1); flash = 1; hits.add(pu.e);
          if (counter) counter.textContent = String(hits.size);
          if (hits.size === eng.length) hold = 1.6;
          continue;
        }
        const k1 = pu.t * pu.t, k0 = Math.max(0, pu.t - 0.14) ** 2;
        const a1x = cx + (e.sx - cx) * (1 - k1), a1y = cy + (e.sy - cy) * (1 - k1);
        const a0x = cx + (e.sx - cx) * (1 - k0), a0y = cy + (e.sy - cy) * (1 - k0);
        const lg = ctx!.createLinearGradient(a0x, a0y, a1x, a1y);
        lg.addColorStop(0, `rgba(${acc},0)`); lg.addColorStop(1, `rgba(${acc},1)`);
        ctx!.strokeStyle = lg; ctx!.lineWidth = dpr * 1.6;
        ctx!.beginPath(); ctx!.moveTo(a0x, a0y); ctx!.lineTo(a1x, a1y); ctx!.stroke();
        ctx!.fillStyle = `rgb(${acc})`; const s = 4 * dpr; ctx!.fillRect(a1x - s / 2, a1y - s / 2, s, s);
      }

      // engine markers and labels, far ones first
      [...eng].sort((a, b) => a.z - b.z).forEach((e) => {
        const d01 = Math.min(1, Math.max(0, (e.z / 1.66 + 1) / 2));
        const al = (0.3 + 0.7 * d01) * ease;
        const m = (6 + 4 * d01) * dpr;
        const lit = e.hit > 0 || hits.has(eng.indexOf(e));
        ctx!.globalAlpha = al;
        ctx!.fillStyle = `rgb(${bg})`; ctx!.fillRect(e.sx - m / 2, e.sy - m / 2, m, m);
        ctx!.strokeStyle = `rgb(${lit ? acc : ink})`; ctx!.lineWidth = dpr * (1 + e.hit);
        ctx!.strokeRect(e.sx - m / 2, e.sy - m / 2, m, m);
        if (lit) { ctx!.fillStyle = `rgb(${acc})`; ctx!.fillRect(e.sx - m / 4, e.sy - m / 4, m / 2, m / 2); }
        const fs = (11.5 + 4 * d01) * dpr * (small ? 0.85 : 1);
        ctx!.font = `${fs}px "Bebas Neue", sans-serif`; ctx!.textBaseline = 'middle';
        const right = e.sx >= cx; ctx!.textAlign = right ? 'left' : 'right';
        ctx!.fillStyle = `rgb(${lit ? acc : ink})`;
        (ctx as any).letterSpacing = `${1.2 * dpr}px`;
        ctx!.fillText(e.name, e.sx + (right ? 1 : -1) * (m / 2 + 7 * dpr), e.sy + dpr);
      });
      ctx!.globalAlpha = 1;

      // the core's nameplate
      const label = 'YOUR BRAND'; const fs = 13 * dpr;
      ctx!.font = `${fs}px "Bebas Neue", sans-serif`; (ctx as any).letterSpacing = `${1.6 * dpr}px`;
      ctx!.textAlign = 'center'; ctx!.textBaseline = 'middle';
      const tw = ctx!.measureText(label).width + 16 * dpr, th = 22 * dpr, ly = cy + Rr * 0.56;
      ctx!.globalAlpha = ease;
      ctx!.fillStyle = `rgba(${bg},.88)`; ctx!.fillRect(cx - tw / 2, ly - th / 2, tw, th);
      ctx!.strokeStyle = `rgba(${acc},${0.6 + flash * 0.4})`; ctx!.lineWidth = dpr; ctx!.strokeRect(cx - tw / 2, ly - th / 2, tw, th);
      ctx!.fillStyle = `rgb(${ink})`; ctx!.fillText(label, cx + dpr, ly + dpr);
      ctx!.globalAlpha = 1;

      // schedule the next answer
      if (reduced) return;
      if (hold > 0) { hold -= dt; if (hold <= 0) { hits.clear(); if (counter) counter.textContent = '0'; } return; }
      nextFire -= dt;
      if (nextFire <= 0) {
        const pool = eng.map((_, i) => i).filter((i) => !hits.has(i) && !pulses.some((p) => p.e === i));
        const pick = pool.length ? pool[(Math.random() * pool.length) | 0] : (Math.random() * eng.length) | 0;
        pulses.push({ e: pick, t: 0 }); eng[pick].hit = 1;
        nextFire = 0.45 + Math.random() * 0.55;
      }
    }

    if (reduced) {
      eng.forEach((_, i) => i < 5 && hits.add(i));
      if (counter) counter.textContent = '5';
      draw(0); document.fonts?.ready.then(() => draw(0));
      return;
    }

    window.addEventListener('pointermove', (e) => { tmx = (e.clientX / window.innerWidth - 0.5) * 2; tmy = (e.clientY / window.innerHeight - 0.5) * 2; }, { passive: true });
    let visible = true, last = 0, raf = 0;
    const loop = (now: number) => {
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now;
      draw(dt);
      raf = visible && !document.hidden ? requestAnimationFrame(loop) : 0;
    };
    const start = () => { if (!raf) { last = 0; raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (visible) start(); }).observe(root);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && visible) start(); });
    start();
  });
</script>
