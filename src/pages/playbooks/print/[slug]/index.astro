---
// PDF interior: light, A4, one section after another. The cover is a separate dark page;
// scripts/make_pdfs.py prints both and merges them.
import Base from '../../../../layouts/Base.astro';
import Blocks from '../../../../components/Blocks.astro';
import { PLAYBOOKS, type Playbook } from '../../../../data/playbooks';
import { SITE, fmtDate } from '../../../../data/site';
export function getStaticPaths() { return PLAYBOOKS.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props as { p: Playbook };
const sources = p.sources.filter((s, i, a) => a.findIndex((x) => x.label === s.label) === i);
---
<Base title={`${p.title} — print`} noindex bare forceTheme="light">
  <div class="doc">
    <section class="pg">
      <p class="kick">{p.title}</p>
      <h2 class="t">Contents</h2>
      <ol class="toc">{p.sections.map((s, i) => (<li><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{s.h}</span></li>))}</ol>
      <p class="note"><b>Who it is for.</b> {p.audience}</p>
      <p class="note">Every number names its source; the full list is on the last page. Updated {fmtDate(p.updated)}.</p>
    </section>

    {p.sections.map((s, i) => (
      <section class:list={['pg', { brk: i === 0 || s.blocks.some((b) => b.type === 'table' && b.rows.length > 6) }]}>
        <p class="kick">{String(i + 1).padStart(2, '0')}</p>
        <h2 class="t">{s.h}</h2>
        {s.lead && <p class="lede">{s.lead}</p>}
        <Blocks blocks={s.blocks} />
      </section>
    ))}

    <section class="pg brk">
      <p class="kick">Next step</p>
      <h2 class="t big">Fifteen minutes. No pitch deck.</h2>
      <p class="lede">Tell us the questions your patients or buyers ask. We will show you who the AI names for them.</p>
      <div class="next"><p class="h">Book a call</p><a href={SITE.meetUrl} class="url">{SITE.meetUrl.replace('https://', '')}</a></div>
      <h3 class="h" style="margin-top:12mm">Sources</h3>
      <ol class="srcs">{sources.map((s) => <li>{s.label}{s.url.startsWith('http') && <> — <span class="u">{s.url}</span></>}</li>)}</ol>
    </section>
  </div>
</Base>

<style is:global>
  @page { size: A4; margin: 18mm 17mm 20mm 17mm; }
  html, body { background: var(--sx-bg) !important; }
  body { font-size: 10.5pt; }
  .doc .pb-stats { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  .doc .pb-v { font-size: 30pt; }
</style>
<style>
  .doc { color: var(--sx-text); }
  .pg { padding-top: 9mm; }
  .pg:first-child { padding-top: 0; }
  .brk { break-before: page; padding-top: 0; }
  .kick { font-family: var(--sx-font-condensed); letter-spacing: .18em; font-size: 12pt; text-transform: uppercase; color: var(--sx-accent); }
  .t { font-family: var(--sx-font-condensed); font-size: 30pt; line-height: .95; text-transform: uppercase; margin-top: 2mm; letter-spacing: .01em; break-after: avoid; }
  .t.big { font-size: 46pt; }
  .h { font-family: var(--sx-font-condensed); font-size: 14pt; letter-spacing: .05em; text-transform: uppercase; line-height: 1.1; }
  p { color: var(--sx-text-secondary); line-height: 1.6; }
  .lede { font-size: 12pt; margin-top: 4mm; max-width: 160mm; }
  .toc { list-style: none; margin-top: 6mm; border-top: 1px solid var(--sx-border-hover); }
  .toc li { display: flex; gap: 8mm; padding: 2.6mm 0; border-bottom: 1px solid var(--sx-border); font-family: var(--sx-font-condensed); font-size: 14pt; letter-spacing: .05em; text-transform: uppercase; }
  .toc .n { color: var(--sx-accent); width: 10mm; }
  .note { margin-top: 6mm; font-size: 10pt; max-width: 165mm; }
  .note b { color: var(--sx-text); }
  .next { margin-top: 10mm; border: 1px solid var(--sx-accent); padding: 8mm; display: grid; gap: 2mm; max-width: 120mm; }
  .url { font-family: var(--sx-font-condensed); font-size: 22pt; letter-spacing: .04em; color: var(--sx-accent); }
  .srcs { margin-top: 4mm; padding-left: 5mm; display: grid; gap: 1.6mm; font-size: 8pt; color: var(--sx-text-secondary); line-height: 1.4; }
  .srcs .u { color: var(--sx-text-muted); overflow-wrap: anywhere; }
</style>
