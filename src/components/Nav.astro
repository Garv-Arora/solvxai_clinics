---
// Four destinations: Home, Case Studies, Playbooks, Contact Us (the booking link).
import Icon from './Icon.astro';
import { SITE } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/', name: 'Home', on: path === '/' },
  { href: '/case-studies/', name: 'Case Studies', on: path.startsWith('/case-studies') },
  { href: '/playbooks/', name: 'Playbooks', on: path.startsWith('/playbooks') },
];
---
<header class="nav" data-nav>
  <div class="wrap nav-row">
    <a href="/" class="wordmark" aria-label="SolvX.AI home">SOLVX<span>.AI</span></a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href} class:list={['nl', { on: l.on }]} aria-current={l.on ? 'page' : undefined}>{l.name}</a>)}
      <a href={SITE.meetUrl} target="_blank" rel="noopener" class="nl">Contact Us</a>
    </nav>

    <div class="nav-right">
      <button class="icon-btn" data-theme-toggle aria-label="Toggle light and dark mode">
        <span class="i-sun"><Icon name="sun" size={16} /></span><span class="i-moon"><Icon name="moon" size={16} /></span>
      </button>
      <a href={SITE.meetUrl} target="_blank" rel="noopener" class="btn nav-cta">Book a call</a>
      <button class="icon-btn menu-btn" data-menu-btn aria-label="Open menu" aria-expanded="false">
        <span class="i-open"><Icon name="menu" size={18} /></span><span class="i-close"><Icon name="x" size={18} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" data-mobile>
    <div class="wrap">
      {links.map((l, i) => <a href={l.href} class="m-item"><span class="m-code">0{i + 1}</span>{l.name}</a>)}
      <a href={SITE.meetUrl} target="_blank" rel="noopener" class="m-item"><span class="m-code">04</span>Contact Us</a>
      <a href="/blog/" class="m-sub">Blog</a>
      <a href={SITE.meetUrl} target="_blank" rel="noopener" class="btn m-cta">Book a call</a>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: transform .6s cubic-bezier(.16,1,.3,1), background-color .3s, border-color .3s; border-bottom: 1px solid transparent; }
  .nav.open { background: var(--sx-dark); }
  .nav.scrolled { background: var(--sx-nav-bg); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-bottom-color: var(--sx-nav-border); }
  .nav-row { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 16px; }
  .wordmark { font-family: var(--sx-font-condensed); font-size: 26px; letter-spacing: .08em; color: var(--sx-nav-logo); line-height: 1; }
  .wordmark span { color: var(--sx-accent); }
  .nav-links { display: none; align-items: stretch; border: 1px solid var(--sx-nav-border); background: var(--sx-nav-bg); backdrop-filter: blur(18px); }
  @media (min-width: 900px) { .nav-links { display: flex; } }
  .nl { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 13px 18px; font-family: var(--sx-font-condensed); font-size: 17px; letter-spacing: .14em; text-transform: uppercase; color: var(--sx-nav-text); transition: color .2s, background-color .2s; }
  .nl::after { content: ''; position: absolute; left: 18px; right: 18px; bottom: 8px; height: 1px; background: var(--sx-accent); transform: scaleX(0); transform-origin: 100% 50%; transition: transform .45s cubic-bezier(.16,1,.3,1); }
  .nl:hover::after { transform: scaleX(1); transform-origin: 0 50%; }
  .nl:hover { color: var(--sx-nav-text-hover); }
  .nl.on { background: var(--sx-nav-active-bg); color: var(--sx-nav-active-text); }
  .nav-right { display: flex; align-items: center; gap: 10px; }
  .icon-btn { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--sx-nav-border); color: var(--sx-nav-text); transition: color .2s, border-color .2s; }
  .icon-btn:hover { color: var(--sx-nav-text-hover); border-color: var(--sx-border-hover); }
  .i-moon, .i-close { display: none; }
  :global(html:not(.dark)) .i-sun { display: none; }
  :global(html:not(.dark)) .i-moon { display: inline-flex; }
  .nav.open .i-open { display: none; } .nav.open .i-close { display: inline-flex; }
  .nav-cta { padding: 11px 20px; font-size: 16px; display: none; }
  @media (min-width: 640px) { .nav-cta { display: inline-flex; } }
  .menu-btn { display: inline-flex; }
  @media (min-width: 900px) { .menu-btn { display: none; } }
  .mobile-panel { position: fixed; inset: 72px 0 0 0; overflow-y: auto; background: var(--sx-dark); border-top: 1px solid var(--sx-nav-border); padding: 20px 0 40px; clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path .7s cubic-bezier(.77,0,.18,1), visibility 0s .7s; }
  .nav.open .mobile-panel { clip-path: inset(0 0 0 0); visibility: visible; transition: clip-path .7s cubic-bezier(.77,0,.18,1), visibility 0s; }
  @media (min-width: 900px) { .mobile-panel { display: none; } }
  .mobile-panel .wrap > * { opacity: 0; transform: translateY(24px); transition: opacity .5s, transform .7s cubic-bezier(.16,1,.3,1); }
  .nav.open .mobile-panel .wrap > * { opacity: 1; transform: none; }
  .nav.open .mobile-panel .wrap > *:nth-child(2) { transition-delay: .08s; } .nav.open .mobile-panel .wrap > *:nth-child(3) { transition-delay: .12s; } .nav.open .mobile-panel .wrap > *:nth-child(4) { transition-delay: .16s; } .nav.open .mobile-panel .wrap > *:nth-child(n+5) { transition-delay: .2s; }
  .m-item { display: flex; gap: 14px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--sx-border); font-family: var(--sx-font-condensed); font-size: clamp(34px, 9vw, 52px); line-height: 1; letter-spacing: .02em; text-transform: uppercase; }
  .m-code { font-family: var(--sx-font-condensed); color: var(--sx-accent); font-size: 20px; letter-spacing: .06em; }
  .m-sub { display: block; padding: 14px 0; border-bottom: 1px solid var(--sx-border); font-size: 15px; color: var(--sx-text-secondary); }
  .m-cta { margin-top: 26px; width: 100%; }
</style>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') nav.classList.remove('open'); });

  const menuBtn = document.querySelector('[data-menu-btn]') as HTMLButtonElement;
  menuBtn.addEventListener('click', () => {
    const o = !nav.classList.contains('open'); nav.classList.toggle('open', o); menuBtn.setAttribute('aria-expanded', String(o));
    const l = (window as any).__lenis; if (l) { o ? l.stop() : l.start(); }
    document.documentElement.style.overflow = o ? 'hidden' : '';
  });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const d = document.documentElement; const dark = !d.classList.contains('dark');
    d.classList.toggle('dark', dark);
    try { localStorage.setItem('solvx-theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
</script>
