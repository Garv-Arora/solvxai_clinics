---
interface Props { sources: { label: string; url: string }[]; title?: string }
const { sources, title = 'Sources' } = Astro.props;
---
{sources.length > 0 && (
  <section class="srcl" aria-labelledby="sources-h">
    <h2 id="sources-h" class="tag">{title}</h2>
    <ol>
      {sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ol>
  </section>
)}
<style>
  .srcl { margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--sx-border); }
  .srcl ol { margin-top: 12px; padding-left: 1.4em; display: grid; gap: 6px; font-size: 14px; color: var(--sx-text-muted); }
  .srcl a { color: var(--sx-text-secondary); border-bottom: 1px solid var(--sx-border-hover); }
  .srcl a:hover { color: var(--sx-accent); border-color: var(--sx-accent); }
</style>
