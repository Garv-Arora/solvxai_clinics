---
// One public case study. Attribution comes first: who did the work, where it was published.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Glyph from '../../components/Glyph.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import StatBand from '../../components/StatBand.astro';
import RowList from '../../components/RowList.astro';
import CTABand from '../../components/CTABand.astro';
import { CASES, CASE_NOTE, type CaseStudy } from '../../data/cases';
import { article } from '../../data/schema';
import { fmtDate } from '../../data/site';

export function getStaticPaths() { return CASES.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props as { c: CaseStudy };
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Case studies', url: '/case-studies/' }, { name: c.practice, url: `/case-studies/${c.slug}/` }];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const stats = c.metrics.slice(0, 3).map((m) => ({ value: m.value, label: m.label, source: c.by.name, url: c.source.url }));
const others = CASES.filter((x) => x.slug !== c.slug);
const jsonld = article(Astro.site!, {
  url: canonical, headline: `${c.practice}: ${c.summary}`, description: c.summary, published: c.read, section: 'Case studies',
  citations: [c.source],
});
---
<Base title={`${c.practice}, ${c.place}: Case Study`} description={`${c.summary} Work by ${c.by.name}; figures as published.`} crumbs={crumbs} jsonld={jsonld} published={c.read} updated={c.read} ogType="article">
  <PageHero size="compact" crumbs={crumbs} eyebrow={`Public case study · ${c.specialty} · ${c.place}`} h1={c.practice} lead={c.summary} primary={false}>
    <p class="by"><Icon name="badge-check" size={16} class="icon-accent" /> Work done and results published by <a href={c.by.url} target="_blank" rel="noopener">{c.by.name}</a>. Not a SolvX.AI client. Read at the source on <time datetime={c.read}>{fmtDate(c.read)}</time>.</p>
    <Fragment slot="viz"><div class="viz"><Glyph name={c.glyph} size={300} /></div></Fragment>
  </PageHero>

  <section class="head">
    <div class="wrap head-in">
      <p class="numeral head-v">{c.headline.value}</p>
      <div><p class="head-l">{c.headline.label}</p><p class="head-s">Source: <a href={c.source.url} target="_blank" rel="noopener">{c.by.name}</a> · {c.period}</p></div>
    </div>
  </section>
  <StatBand stats={stats} />

  <section class="section">
    <div class="wrap two-col">
      <div>
        <SectionHead index="01" eyebrow={`What was done · ${c.period}`} title="The work" />
        <ul class="list did">
          {c.did.map((d) => <li data-reveal><Icon name="check" size={18} class="icon-accent" /><span>{d}</span></li>)}
        </ul>
      </div>
      <div>
        <SectionHead index="02" eyebrow="What we take from it" title="The lesson" />
        <ul class="list take">
          {c.takeaways.map((d, i) => <li data-reveal><span class="n">0{i + 1}</span><span>{d}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  {(c.quote || c.also) && (
    <section class="section section-dark section-bordered">
      <div class="wrap extra">
        {c.quote && (
          <figure class="q" data-reveal>
            <Icon name="quote" size={30} class="icon-accent" />
            <blockquote class="quote">{c.quote.text}</blockquote>
            <figcaption class="small">{c.quote.who}</figcaption>
          </figure>
        )}
        {c.also && (
          <div class="also" data-reveal>
            <p class="eyebrow plain">{c.also.title}</p>
            <p class="also-t">{c.also.text}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="src">
        <p class="tag">Source</p>
        <p class="src-l"><a href={c.source.url} target="_blank" rel="noopener">{c.source.label} <Icon name="external-link" size={14} /></a></p>
        <p class="small">{CASE_NOTE}{c.lead ? ` The practice is led by ${c.lead}, as named on the source page.` : ''}</p>
      </div>
      <div style="margin-top:64px">
        <SectionHead eyebrow="More case studies" title="Other clinics" />
        <div style="margin-top:32px"><RowList rows={others.map((x) => ({ href: `/case-studies/${x.slug}/`, title: x.practice, desc: x.aiAngle, meta: `${x.place} · ${x.specialty}` }))} /></div>
      </div>
    </div>
  </section>

  <CTABand title="Where does your practice stand?" text="Fifteen minutes to agree the questions your patients ask. Then we show you who the AI names for them." />
</Base>

<style>
  .by { margin-top: 20px; font-size: 14px; line-height: 1.6; color: var(--sx-text-secondary); max-width: 640px; }
  .by :global(svg) { display: inline-block; vertical-align: -3px; margin-right: 6px; }
  .head { border-bottom: 1px solid var(--sx-border); }
  .head-in { display: grid; gap: 18px; align-items: end; padding-top: 56px; padding-bottom: 48px; }
  @media (min-width: 900px) { .head-in { grid-template-columns: auto 1fr; gap: 48px; } }
  .head-v { font-size: clamp(72px, 12vw, 200px); line-height: .82; white-space: nowrap; }
  .head-l { font-size: clamp(17px, 1.6vw, 22px); line-height: 1.4; color: var(--sx-text); max-width: 420px; }
  .head-s { margin-top: 10px; font-size: 12px; color: var(--sx-text-muted); }
  .head-s a { border-bottom: 1px solid var(--sx-border-hover); }
  .by a { color: var(--sx-accent); border-bottom: 1px solid var(--sx-accent-soft); }
  .viz { display: grid; place-items: center; opacity: .9; }
  .list { list-style: none; display: grid; margin-top: 28px; border-top: 1px solid var(--sx-border); }
  .list li { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; padding: 16px 0; border-bottom: 1px solid var(--sx-border); font-size: 17px; line-height: 1.5; color: var(--sx-text); }
  .list li :global(svg) { margin-top: 4px; }
  .take .n { font-family: var(--sx-font-condensed); font-size: 26px; line-height: 1; color: var(--sx-accent); letter-spacing: .04em; }
  .extra { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .extra { grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; } }
  .q { display: grid; gap: 14px; }
  .q .quote { font-size: clamp(24px, 2.6vw, 34px); line-height: 1.3; }
  .also { border: 1px solid var(--sx-border-dark-hover, var(--sx-border)); padding: 26px; display: grid; gap: 12px; }
  .also-t { font-size: 17px; line-height: 1.6; color: var(--sx-text); }
  .src { border: 1px solid var(--sx-border); border-left: 2px solid var(--sx-accent); padding: 22px 24px; display: grid; gap: 10px; max-width: 900px; }
  .src-l a { display: inline-flex; gap: 8px; align-items: center; font-size: 17px; color: var(--sx-text); border-bottom: 1px solid var(--sx-border-hover); }
  .src-l a:hover { color: var(--sx-accent); border-color: var(--sx-accent); }
</style>
