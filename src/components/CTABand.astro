---
// Closing call to action: big split title plus a spinning "book a call" badge.
import Icon from './Icon.astro';
import { SITE } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Fifteen minutes. No pitch deck.', text = 'Tell us what you are trying to grow. We will tell you which system fits, or that none of ours does.' } = Astro.props;
const pid = `spin-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="cta section-dark grid-live">
  <div class="wrap cta-in">
    <div class="cta-copy">
      <p class="eyebrow">Book a call</p>
      <h2 class="display cta-h" data-split>{title}</h2>
      <p class="lead cta-p">{text}</p>
      <div class="btn-row cta-row">
        <a href={SITE.meetUrl} target="_blank" rel="noopener" class="btn">Book a 15-minute call <Icon name="arrow-right" size={18} stroke={2} /></a>
        <a href="/case-studies/" class="link-arrow">Or read the case studies <Icon name="arrow-right" size={16} /></a>
      </div>
      <p class="small cta-micro">A real conversation about your pipeline · No commitment · We say no when it isn’t a fit</p>
    </div>
    <a href={SITE.meetUrl} target="_blank" rel="noopener" class="spin" data-magnetic aria-label="Book a 15-minute call">
      <svg viewBox="0 0 200 200" class="spin-ring" aria-hidden="true">
        <defs><path id={pid} d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" /></defs>
        <text class="spin-t"><textPath href={`#${pid}`} textLength="498" lengthAdjust="spacing">BOOK A 15-MINUTE CALL · BE THE ANSWER · </textPath></text>
      </svg>
      <span class="spin-core"><Icon name="arrow-up-right" size={40} stroke={1.5} /></span>
    </a>
  </div>
</section>
<style>
  .cta { padding: 96px 0; border-top: 1px solid var(--sx-border-dark); }
  @media (min-width: 1024px) { .cta { padding: 140px 0; } }
  .cta-in { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1024px) { .cta-in { grid-template-columns: 1fr auto; gap: 64px; } }
  .cta-h { margin-top: 20px; font-size: clamp(54px, 8vw, 132px); max-width: 13ch; }
  .cta-p { margin-top: 22px; max-width: 620px; }
  .cta-row { margin-top: 32px; gap: 22px; }
  .cta-micro { margin-top: 18px; }
  .spin { position: relative; width: clamp(170px, 18vw, 240px); aspect-ratio: 1; display: grid; place-items: center; justify-self: start; }
  @media (min-width: 1024px) { .spin { justify-self: end; } }
  .spin-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 16s linear infinite; }
  .spin:hover .spin-ring { animation-duration: 5s; }
  .spin-t { font-family: var(--sx-font-condensed); font-size: 17px; letter-spacing: .08em; fill: var(--sx-text); }
  .spin-core { width: 46%; aspect-ratio: 1; border-radius: 50%; background: var(--sx-accent); color: var(--sx-dark); display: grid; place-items: center; transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  .spin:hover .spin-core { transform: scale(1.1) rotate(45deg); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin-ring { animation: none; } }
</style>
